LOCADORA_ADMIN_USUARIO=admin
LOCADORA_ADMIN_SENHA=coloque_uma_senha_aqui
LOCADORA_JWT_SECRET=coloque_uma_chave_secreta_aqui
LOCADORA_DATABASE_URL=sqlite:///dados/locadora.db

# PostgreSQL de desenvolvimento:
# LOCADORA_DATABASE_URL=postgresql+psycopg://locadora_app:SUA_SENHA@localhost:5432/locadora_dev

# Neon / produção (a aplicação converte postgresql:// para psycopg 3):
# LOCADORA_DATABASE_URL=postgresql://USUARIO:SENHA@ENDPOINT-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Usada somente pelos testes de integração PostgreSQL:
# LOCADORA_TEST_DATABASE_URL=postgresql+psycopg://locadora_app:SUA_SENHA@localhost:5432/locadora_test

#  NOME APP: Locadora API

# Brevo / e-mail transacional
LOCADORA_BREVO_API_KEY=coloque_sua_chave_brevo_aqui
LOCADORA_EMAIL_REMETENTE=seu_email_verificado_aqui
LOCADORA_PUBLIC_URL=http://127.0.0.1:8000

# Produção:
# LOCADORA_PUBLIC_URL=https://locadora-fastapi.onrender.com

# Monitoramento de erros / Sentry (opcional)
LOCADORA_AMBIENTE=development
# LOCADORA_SENTRY_DSN=https://SUA_CHAVE@SEU_HOST.ingest.sentry.io/SEU_PROJETO


# Redis / cache (opcional; sem URL a aplicação usa fallback local)
# Render Key Value / Redis / Valkey: redis://HOST:6379
LOCADORA_REDIS_URL=
LOCADORA_REDIS_PREFIXO=locadora
LOCADORA_REDIS_TIMEOUT_MS=500
LOCADORA_CACHE_DASHBOARD_TTL_SEGUNDOS=30

# Background jobs / fila persistente
LOCADORA_BACKGROUND_JOBS_ENABLED=false
LOCADORA_BACKGROUND_JOBS_INTERVALO_SEGUNDOS=60
LOCADORA_BACKGROUND_JOBS_LOTE=50
LOCADORA_BACKGROUND_JOBS_TIMEOUT_BLOQUEIO_SEGUNDOS=900

# Backup e recuperação (opcional; usado pelo CLI operacional)
# Em Neon, prefira uma connection string DIRETA (sem -pooler) para pg_dump.
# LOCADORA_BACKUP_DATABASE_URL=postgresql://USUARIO:SENHA@ENDPOINT.us-east-1.aws.neon.tech/neondb?sslmode=require
LOCADORA_BACKUP_DIRETORIO=backups
LOCADORA_BACKUP_MANTER=7
# Windows, caso pg_dump/pg_restore não estejam no PATH:
# LOCADORA_PG_DUMP=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
# LOCADORA_PG_RESTORE=C:\Program Files\PostgreSQL\18\bin\pg_restore.exe
