# Produção — modelo sem segredos reais
LOCADORA_AMBIENTE=production
LOCADORA_ADMIN_USUARIO=admin
LOCADORA_ADMIN_SENHA=DEFINA_NO_PROVEDOR
LOCADORA_JWT_SECRET=DEFINA_NO_PROVEDOR
LOCADORA_DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO_PRODUCAO?sslmode=require
LOCADORA_PUBLIC_URL=https://locadora-fastapi.onrender.com
LOCADORA_SENTRY_DSN=
LOCADORA_REDIS_URL=
LOCADORA_REDIS_PREFIXO=locadora:production
LOCADORA_BACKGROUND_JOBS_ENABLED=true
LOCADORA_MENSAGERIA_ENABLED=true
LOCADORA_MENSAGERIA_INTERVALO_SEGUNDOS=5
LOCADORA_MENSAGERIA_LOTE=100
LOCADORA_MENSAGERIA_TIMEOUT_BLOQUEIO_SEGUNDOS=60
LOCADORA_MENSAGERIA_RETRY_BASE_SEGUNDOS=5
LOCADORA_MENSAGERIA_RETRY_MAX_SEGUNDOS=300
