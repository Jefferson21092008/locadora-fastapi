# Desenvolvimento local — copie para .env
LOCADORA_AMBIENTE=development
LOCADORA_ADMIN_USUARIO=admin
LOCADORA_ADMIN_SENHA=troque_esta_senha_local
LOCADORA_JWT_SECRET=troque_esta_chave_local
LOCADORA_DATABASE_URL=sqlite:///dados/locadora.db
LOCADORA_PUBLIC_URL=http://127.0.0.1:8000
LOCADORA_REDIS_URL=
LOCADORA_REDIS_PREFIXO=locadora:development
LOCADORA_BACKGROUND_JOBS_ENABLED=false
LOCADORA_MENSAGERIA_ENABLED=false
LOCADORA_MENSAGERIA_INTERVALO_SEGUNDOS=5
LOCADORA_MENSAGERIA_LOTE=100
LOCADORA_MENSAGERIA_TIMEOUT_BLOQUEIO_SEGUNDOS=60
LOCADORA_MENSAGERIA_RETRY_BASE_SEGUNDOS=5
LOCADORA_MENSAGERIA_RETRY_MAX_SEGUNDOS=300

# Escala horizontal / pool de conexões
LOCADORA_ESCALA_HORIZONTAL_ENABLED=false
LOCADORA_WORKERS_EMBUTIDOS=true
LOCADORA_CONTAINER_APLICAR_MIGRATIONS=true
LOCADORA_DB_POOL_SIZE=5
LOCADORA_DB_MAX_OVERFLOW=5
LOCADORA_DB_POOL_TIMEOUT_SEGUNDOS=30
